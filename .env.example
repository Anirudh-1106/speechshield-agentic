# SpeechShield environment overrides — copy to .env (git-ignored) and edit.
# Every variable is optional; defaults come from config/default.yaml and
# config/<SPEECHSHIELD_ENV>.yaml. Full list: CONFIG.md

# Profile: dev | test | prod
SPEECHSHIELD_ENV=dev

# ---- Interceptor (filtering a call) ---------------------------------------
# SPEECHSHIELD_INTERCEPTOR_ENABLED=true
# SPEECHSHIELD_CENSOR_MODE=bleep            # bleep | mute | voice_clone | tts
# SPEECHSHIELD_STREAMING=auto               # auto | on | off
# SPEECHSHIELD_FAIL_MODE=closed             # closed | open
# SPEECHSHIELD_INTERCEPTOR_INPUT_DEVICE=CABLE Output
# SPEECHSHIELD_INTERCEPTOR_OUTPUT_DEVICE=   # empty = system default
# SPEECHSHIELD_INTERCEPTOR_DELAY=0.8

# ---- Speech recognition -----------------------------------------------------
# SPEECHSHIELD_ASR_MODEL_SIZE=auto          # auto = small on GPU, base.en on CPU
# SPEECHSHIELD_ASR_DEVICE=auto              # auto | cuda | cpu

# ---- Toxicity ---------------------------------------------------------------
# SPEECHSHIELD_TOXICITY_THRESHOLD=0.5

# ---- LLM rewriting (optional) ------------------------------------------------
# SPEECHSHIELD_REWRITE_PROVIDER=ollama      # ollama | openai | local (rules only)
# SPEECHSHIELD_REWRITE_MODEL=qwen2.5:3b
# SPEECHSHIELD_OLLAMA_BASE_URL=http://localhost:11434
# SPEECHSHIELD_OPENAI_BASE_URL=https://api.openai.com/v1
# SPEECHSHIELD_OPENAI_API_KEY=

# ---- Voice-clone worker ------------------------------------------------------
# SPEECHSHIELD_VOICE_DEVICE=cuda
# SPEECHSHIELD_VOICE_PORT=9502

# ---- HTTP API / metrics -------------------------------------------------------
# SPEECHSHIELD_SERVER_PORT=9501
# SPEECHSHIELD_API_KEY=                     # require "Authorization: Bearer <key>" on /v1/*
# SPEECHSHIELD_RATE_LIMIT=120               # requests/minute per client

# ---- Speaker identification (optional) ------------------------------------------
# SPEECHSHIELD_DIARIZATION_ENABLED=false
# HF_TOKEN=

# ---- Logging ------------------------------------------------------------------
# SPEECHSHIELD_LOG_LEVEL=INFO
# SPEECHSHIELD_LOG_FORMAT=text              # text | json
