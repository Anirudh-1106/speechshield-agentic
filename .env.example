# SpeechShield Environment Configuration
# Copy to .env and customize for your environment
# All variables are optional; defaults come from config/{ENV}.yaml

# Environment: dev, test, or prod
SPEECHSHIELD_ENV=dev

# Debug mode (true/false)
SPEECHSHIELD_DEBUG=false

# ============================================================================
# Audio Configuration
# ============================================================================

# Sample rate in Hz
SPEECHSHIELD_SAMPLE_RATE=16000

# Number of channels (1 = mono)
SPEECHSHIELD_CHANNELS=1

# Audio chunk size in samples
SPEECHSHIELD_CHUNK_SIZE=1024

# Audio input device index (use null or omit for default)
# SPEECHSHIELD_INPUT_DEVICE=0

# Audio output device index (use null or omit for default)
# SPEECHSHIELD_OUTPUT_DEVICE=0

# Max size of audio chunk queue
SPEECHSHIELD_AUDIO_QUEUE_SIZE=200

# ============================================================================
# ASR (Speech Recognition) Configuration
# ============================================================================

# Faster-Whisper model size: tiny, base, small, medium, large
SPEECHSHIELD_ASR_MODEL_SIZE=small

# Directory for cached ASR models
SPEECHSHIELD_ASR_MODEL_DIR=models/

# ASR inference timeout (seconds)
SPEECHSHIELD_ASR_TIMEOUT=30

# ============================================================================
# Toxicity Detection Configuration
# ============================================================================

# Toxicity model name/path
SPEECHSHIELD_TOXICITY_MODEL=models/toxic-bert

# Toxicity score threshold (0-1)
SPEECHSHIELD_TOXICITY_THRESHOLD=0.5

# Toxicity inference timeout (seconds)
SPEECHSHIELD_TOXICITY_TIMEOUT=5

# ============================================================================
# LLM Rewriting Configuration
# ============================================================================

# LLM provider: ollama, openai, or local
SPEECHSHIELD_REWRITE_PROVIDER=ollama

# Ollama server base URL
SPEECHSHIELD_OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name
SPEECHSHIELD_REWRITE_MODEL=gemma:1b

# Rewrite inference timeout (seconds)
SPEECHSHIELD_REWRITE_TIMEOUT=10

# Max rewrite retry attempts
SPEECHSHIELD_REWRITE_MAX_RETRIES=2

# Enable fallback to rules if LLM fails
SPEECHSHIELD_REWRITE_FALLBACK=true

# ============================================================================
# Text-to-Speech Configuration
# ============================================================================

# TTS provider: edge_tts, espeak, pyttsx3
SPEECHSHIELD_TTS_PROVIDER=edge_tts

# Edge TTS voice ID
SPEECHSHIELD_TTS_VOICE=en-US-GuyNeural

# TTS synthesis timeout (seconds)
SPEECHSHIELD_TTS_TIMEOUT=15

# Enable audio playback
SPEECHSHIELD_PLAY_AUDIO=true

# Support virtual audio devices (VB-Cable, etc)
SPEECHSHIELD_VIRTUAL_DEVICE=false

# ============================================================================
# Pipeline Configuration
# ============================================================================

# Target end-to-end latency budget (milliseconds)
SPEECHSHIELD_LATENCY_BUDGET=500

# Default rewrite strictness (1.0 = normal, higher = stricter)
SPEECHSHIELD_STRICTNESS=1.0

# Number of passes to track for latency averaging
SPEECHSHIELD_LATENCY_WINDOW=100

# Graceful shutdown timeout (seconds)
SPEECHSHIELD_SHUTDOWN_TIMEOUT=10

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
SPEECHSHIELD_LOG_LEVEL=INFO

# Log directory
SPEECHSHIELD_LOG_DIR=logs/

# Log format: text or json
SPEECHSHIELD_LOG_FORMAT=text

# Enable file logging
SPEECHSHIELD_FILE_LOGGING=true

# ============================================================================
# Dashboard Configuration
# ============================================================================

# Enable Streamlit dashboard
SPEECHSHIELD_DASHBOARD_ENABLED=true

# Dashboard port
SPEECHSHIELD_DASHBOARD_PORT=8501

# Dashboard refresh interval (seconds)
SPEECHSHIELD_DASHBOARD_REFRESH=1.0

# Max dashboard feed rows to keep
SPEECHSHIELD_DASHBOARD_MAX_ROWS=500
